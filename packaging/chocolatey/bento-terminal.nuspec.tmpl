    <authors>Trishiraj</authors>
    <owners>StarkDroid</owners>
    <projectUrl>https://starkdroid.github.io/Bento-Terminal/</projectUrl>
    <packageSourceUrl>https://github.com/StarkDroid/Bento-Terminal</packageSourceUrl>
